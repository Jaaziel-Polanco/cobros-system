{
  "name": "cobros-print-agent",
  "version": "1.1.0",
  "private": true,
  "description": "Agente local de impresión de boletos para impresoras POS de sucursal (red o Windows)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsc && node dist/simulador-servidor.js"
  },
  "devDependencies": {
    "@types/node": "^20",
    "iconv-lite": "^0.7.3",
    "typescript": "^5",
    "vitest": "^3"
  }
}
